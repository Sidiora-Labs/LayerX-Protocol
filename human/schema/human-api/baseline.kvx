identity.kvx:scalar.AccountId.prefix = "act_"
identity.kvx:scalar.AccountId.rust = "String"
identity.kvx:scalar.AccountId.typescript = "string"
identity.kvx:scalar.AssertionId.json = "string"
identity.kvx:scalar.AssertionId.prefix = "asr_"
identity.kvx:scalar.AssertionId.rust = "String"
identity.kvx:scalar.AssertionId.typescript = "string"
