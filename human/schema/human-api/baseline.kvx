identity.kvx:scalar.EvmAddress.prefix = "0x"
identity.kvx:scalar.EvmAddress.rendering = "Always transported and rendered in its full checksummed mixed-case form, never a truncation alone."
identity.kvx:scalar.EvmAddress.rust = "String"
identity.kvx:scalar.EvmAddress.typescript = "string"
identity.kvx:scalar.EvmSignature.json = "string"
identity.kvx:scalar.EvmSignature.prefix = "0x"
identity.kvx:scalar.EvmSignature.rust = "String"
identity.kvx:scalar.EvmSignature.typescript = "string"
identity.kvx:scalar.OpaqueCredential.json = "string"
identity.kvx:scalar.OpaqueCredential.opacity = "A base64url string the platform credential machinery produces or consumes. This plane relays it unread, and it never contains key material this plane can use."
identity.kvx:scalar.OpaqueCredential.rust = "String"
identity.kvx:scalar.OpaqueCredential.typescript = "string"
identity.kvx:scalar.OperationDigest.binding = "Names exactly one operation a person is confirming. A step-up ceremony answers for this one digest and for nothing else."
identity.kvx:scalar.OperationDigest.json = "string"
identity.kvx:scalar.OperationDigest.prefix = "opd_"
identity.kvx:scalar.OperationDigest.rust = "String"
identity.kvx:scalar.OperationDigest.typescript = "string"
