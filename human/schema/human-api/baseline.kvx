[manifest]
tool = "layerx-human-schema-check"
schema_major = 1
refresh = "cargo run --manifest-path human/tools/schema-check/Cargo.toml --locked -- --write-baseline human/schema/human-api"

[entries]
compatibility.kvx:compatibility.row.1.schema = "1.0"
compatibility.kvx:compatibility.row.1.service = "0.1.x"
compatibility.kvx:compatibility.row.1.web_app = "0.1.x"
compatibility.kvx:compatibility.rule = "Every released pairing of contract schema, human service and web application versions is recorded here as a row. The conformance suite validates the shape of every row, and published rows are frozen by the additive-only baseline."
errors.kvx:module.compatibility = "additive_only"
errors.kvx:module.contract_major = 1
errors.kvx:module.model = "Every failure response carries one typed shape: a stable machine code, the copy-catalog key naming the human message, the trace identifier on the envelope, and a retriability classification. No operation returns an unstructured error."
errors.kvx:module.name = "errors"
errors.kvx:module.report = "The envelope trace identifier is the key the Report action submits and the key support uses to retrieve the failure context the user saw."
errors.kvx:type.ApiError.field_errors = "A failure caused by one invalid input names it in field so forms can show the error inline at that field."
errors.kvx:type.ApiError.optional = ["retry_after_ms:integer","field:string"]
errors.kvx:type.ApiError.rate_limit = "A rate-limited failure carries retry_after_ms so clients surface honest retry timing, as the retriable-after classification requires."
errors.kvx:type.ApiError.required = ["code:ErrorCode","copy_key:CopyKey","retry:Retriability"]
errors.kvx:type.ErrorCode.stability = "Machine codes are stable identifiers. A code is never renamed or removed within a major version; new failure classes append new codes."
errors.kvx:type.ErrorCode.variants = ["unauthenticated","session-expired","step-up-required","forbidden","not-found","invalid-request","conflict","rate-limited","cursor-expired","unavailable","upstream-degraded","challenge-expired","refused-by-policy","refused-by-budget","refused-by-capability","refused-by-protocol","refused-by-limit","quote-expired","wallet-not-bound","exit-unavailable"]
errors.kvx:type.Retriability.final.semantics = "The outcome is settled. The plane never retries into a different outcome and surfaces state the result honestly."
errors.kvx:type.Retriability.retriable-after.semantics = "The same request may be retried once the carried retry_after_ms has elapsed. Rate-limit refusals always classify here and always carry the timing."
errors.kvx:type.Retriability.retriable.semantics = "The same request may be retried as-is. Surfaces offer Retry."
errors.kvx:type.Retriability.structural.semantics = "Retrying the same call cannot help until surrounding state changes, such as re-authentication or a reload. Surfaces offer Reload."
errors.kvx:type.Retriability.variants = ["retriable","retriable-after","structural","final"]
identity.kvx:module.ceremonies = "Passkey ceremonies travel as typed records whose ceremony and credential fields are opaque base64 strings produced and consumed by the platform credential machinery. This plane relays them without interpreting them."
identity.kvx:module.compatibility = "additive_only"
identity.kvx:module.contract_major = 1
identity.kvx:module.name = "identity"
identity.kvx:module.separation = "The application identity a passkey unlocks, the protocol identity the custody service establishes underneath it, and the wallet a person links for money in and out are three distinct things. Protocol mechanics stay behind evidence references, and the browser never holds signing power."
identity.kvx:module.spine = "One account held by passkeys, carried by sessions, linked to one payout wallet. Everything a person can do on the authenticated plane starts with the operations declared here: creating the account, confirming it is really them, watching onboarding finish honestly, and linking the wallet their money arrives from and returns to."
identity.kvx:operation.account.create.convergence = "Repeating the request under the same key returns the original account and its onboarding journey: one application identity, one protocol identity, one set of receipts, no orphaned protocol state."
identity.kvx:operation.account.create.idempotency = true
identity.kvx:operation.account.create.method = "POST"
identity.kvx:operation.account.create.path = "/v1/accounts"
identity.kvx:operation.account.create.request = "AccountCreateRequest"
identity.kvx:operation.account.create.response = "AccountCreation"
identity.kvx:operation.binding.rebind.idempotency = true
identity.kvx:operation.binding.rebind.method = "POST"
identity.kvx:operation.binding.rebind.path = "/v1/wallet-binding/rebind"
identity.kvx:operation.binding.rebind.request = "RebindingSubmission"
identity.kvx:operation.binding.rebind.response = "Journey"
identity.kvx:operation.binding.rebind.step_up = "Replacing the payout wallet requires fresh step-up evidence confirming exactly this operation. The old binding stays effective until the new one's receipt-backed evidence verifies, and a security notification with an action is sent."
identity.kvx:operation.binding.statement.method = "POST"
identity.kvx:operation.binding.statement.path = "/v1/wallet-binding/statement"
identity.kvx:operation.binding.statement.request = "BindingStatementRequest"
identity.kvx:operation.binding.statement.response = "BindingStatement"
identity.kvx:operation.binding.status.method = "GET"
identity.kvx:operation.binding.status.path = "/v1/wallet-binding"
identity.kvx:operation.binding.status.request = "Empty"
identity.kvx:operation.binding.status.response = "WalletBinding"
identity.kvx:operation.binding.submit.idempotency = true
identity.kvx:operation.binding.submit.journey = "Returns the journey of kind wallet-binding. The binding reads as established only when its receipt-backed evidence verifies, and a signature from any address other than the named one is refused, never silently accepted."
identity.kvx:operation.binding.submit.method = "POST"
identity.kvx:operation.binding.submit.path = "/v1/wallet-binding"
identity.kvx:operation.binding.submit.request = "BindingSubmission"
identity.kvx:operation.binding.submit.response = "Journey"
identity.kvx:operation.onboarding.resume.method = "POST"
identity.kvx:operation.onboarding.resume.path = "/v1/onboarding/resume"
identity.kvx:operation.onboarding.resume.request = "Empty"
identity.kvx:operation.onboarding.resume.response = "Journey"
identity.kvx:operation.onboarding.resume.resumption = "Resuming after a crash, a timeout or a repeated request converges on the one journey account creation started, without restarting completed stages and without orphaned protocol state."
identity.kvx:operation.onboarding.status.active = "The account reads as active only when the journey's protocol-identity stage carries evidence of class layerx-receipt at verification receipt-verified or higher. No stage is presented as done from local state alone."
identity.kvx:operation.onboarding.status.kind = "The journey of kind onboarding: creating the account, adding the passkey, establishing the protocol identity, putting recovery in place, each stage reported honestly."
identity.kvx:operation.onboarding.status.method = "GET"
identity.kvx:operation.onboarding.status.path = "/v1/onboarding"
identity.kvx:operation.onboarding.status.request = "Empty"
identity.kvx:operation.onboarding.status.response = "Journey"
identity.kvx:operation.passkey.assert.begin.method = "POST"
identity.kvx:operation.passkey.assert.begin.path = "/v1/passkeys/assertions"
identity.kvx:operation.passkey.assert.begin.request = "PasskeyAssertionBegin"
identity.kvx:operation.passkey.assert.begin.response = "PasskeyAssertionChallenge"
identity.kvx:operation.passkey.assert.finish.method = "POST"
identity.kvx:operation.passkey.assert.finish.path = "/v1/passkeys/assertions/{assertion_id}"
identity.kvx:operation.passkey.assert.finish.request = "PasskeyAssertionFinish"
identity.kvx:operation.passkey.assert.finish.response = "PasskeyAssertion"
identity.kvx:operation.passkey.register.begin.method = "POST"
identity.kvx:operation.passkey.register.begin.path = "/v1/passkeys/registrations"
identity.kvx:operation.passkey.register.begin.request = "PasskeyRegistrationBegin"
identity.kvx:operation.passkey.register.begin.response = "PasskeyRegistrationChallenge"
identity.kvx:operation.passkey.register.finish.method = "POST"
identity.kvx:operation.passkey.register.finish.path = "/v1/passkeys/registrations/{registration_id}"
identity.kvx:operation.passkey.register.finish.request = "PasskeyRegistrationFinish"
identity.kvx:operation.passkey.register.finish.response = "Passkey"
identity.kvx:operation.profile.get.method = "GET"
identity.kvx:operation.profile.get.path = "/v1/profile"
identity.kvx:operation.profile.get.request = "Empty"
identity.kvx:operation.profile.get.response = "Profile"
identity.kvx:operation.profile.update.method = "PATCH"
identity.kvx:operation.profile.update.path = "/v1/profile"
identity.kvx:operation.profile.update.request = "ProfileUpdate"
identity.kvx:operation.profile.update.response = "Profile"
identity.kvx:operation.session.list.method = "GET"
identity.kvx:operation.session.list.path = "/v1/sessions"
identity.kvx:operation.session.list.request = "Empty"
identity.kvx:operation.session.list.response = "SessionList"
identity.kvx:operation.session.open.method = "POST"
identity.kvx:operation.session.open.path = "/v1/sessions"
identity.kvx:operation.session.open.request = "SessionOpenRequest"
identity.kvx:operation.session.open.response = "Session"
identity.kvx:operation.session.open.scope = "Every operation on the authenticated plane is scoped to the principal this session belongs to. A session never grants a view into anyone else's account, and opening one on a new device records the device and sends a security notification."
identity.kvx:operation.session.refresh.method = "POST"
identity.kvx:operation.session.refresh.path = "/v1/sessions/refresh"
identity.kvx:operation.session.refresh.request = "Empty"
identity.kvx:operation.session.refresh.response = "Session"
identity.kvx:operation.session.revoke-all.everywhere = "Signs out every session of the principal, including the one making the call."
identity.kvx:operation.session.revoke-all.method = "POST"
identity.kvx:operation.session.revoke-all.path = "/v1/sessions/revoke-all"
identity.kvx:operation.session.revoke-all.request = "Empty"
identity.kvx:operation.session.revoke-all.response = "SessionRevocation"
identity.kvx:operation.session.revoke.effect = "Revocation takes effect promptly on every shell holding the session."
identity.kvx:operation.session.revoke.method = "DELETE"
identity.kvx:operation.session.revoke.path = "/v1/sessions/{session_id}"
identity.kvx:operation.session.revoke.request = "Empty"
identity.kvx:operation.session.revoke.response = "SessionRevocation"
identity.kvx:operation.stepup.begin.method = "POST"
identity.kvx:operation.stepup.begin.path = "/v1/step-up"
identity.kvx:operation.stepup.begin.request = "StepUpRequest"
identity.kvx:operation.stepup.begin.response = "StepUpChallenge"
identity.kvx:operation.stepup.finish.method = "POST"
identity.kvx:operation.stepup.finish.path = "/v1/step-up/{challenge_id}"
identity.kvx:operation.stepup.finish.request = "StepUpFinish"
identity.kvx:operation.stepup.finish.response = "StepUpEvidence"
