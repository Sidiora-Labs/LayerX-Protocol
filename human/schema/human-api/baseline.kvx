identity.kvx:type.AccountCreateRequest.required = ["email:EmailAddress","display_name:string"]
identity.kvx:type.AccountCreation.journey = "Creating an account starts the onboarding journey that stands up the protocol identity underneath it, and the journey is the account's honest per-stage progress from the first moment."
identity.kvx:type.AccountCreation.required = ["account_id:AccountId","onboarding:Journey"]
identity.kvx:type.BindingState.variants = ["none","binding","bound","rebinding"]
identity.kvx:type.BindingStatement.authority = "The linked wallet is a payout and provenance association only. It cannot move LayerX funds."
identity.kvx:type.BindingStatement.exactness = "statement is the exact text the wallet must sign, character for character. The wallet opens once to sign it and at no other moment."
identity.kvx:type.BindingStatement.required = ["statement:string","address:EvmAddress","expires_at:Timestamp"]
identity.kvx:type.BindingStatementRequest.required = ["address:EvmAddress"]
identity.kvx:type.BindingSubmission.required = ["address:EvmAddress","statement:string","signature:EvmSignature"]
identity.kvx:type.Device.required = ["device_id:DeviceId","label:string","platform:string"]
identity.kvx:type.Passkey.optional = ["last_used_at:Timestamp"]
identity.kvx:type.Passkey.required = ["passkey_id:PasskeyId","label:string","created_at:Timestamp"]
identity.kvx:type.PasskeyAssertion.consumption = "A completed assertion opens exactly one session before expires_at, then it is spent."
identity.kvx:type.PasskeyAssertion.required = ["assertion_id:AssertionId","passkey_id:PasskeyId","completed_at:Timestamp","expires_at:Timestamp"]
identity.kvx:type.PasskeyAssertionBegin.discovery = "Sign-in may begin with an email address, or with no input at all when the platform offers a discoverable passkey."
identity.kvx:type.PasskeyAssertionBegin.optional = ["email:EmailAddress"]
identity.kvx:type.PasskeyAssertionBegin.required = []
identity.kvx:type.PasskeyAssertionChallenge.required = ["assertion_id:AssertionId","ceremony:OpaqueCredential","expires_at:Timestamp"]
identity.kvx:type.PasskeyAssertionFinish.required = ["credential:OpaqueCredential"]
identity.kvx:type.PasskeyRegistrationBegin.required = ["account_id:AccountId"]
identity.kvx:type.PasskeyRegistrationChallenge.required = ["registration_id:RegistrationId","ceremony:OpaqueCredential","expires_at:Timestamp"]
identity.kvx:type.PasskeyRegistrationFinish.required = ["credential:OpaqueCredential"]
identity.kvx:type.Profile.locality = "Declared-local data. Editing or deleting it never touches protocol identity or protocol state."
identity.kvx:type.Profile.optional = ["avatar_url:string"]
identity.kvx:type.Profile.required = ["display_name:string"]
identity.kvx:type.ProfileUpdate.optional = ["display_name:string","avatar_url:string"]
identity.kvx:type.ProfileUpdate.required = []
identity.kvx:type.RebindingSubmission.required = ["address:EvmAddress","statement:string","signature:EvmSignature","step_up:StepUpEvidence"]
identity.kvx:type.Session.inventory = "The session inventory shows every device holding access, each with its last activity, so a person can see and end access from anywhere."
identity.kvx:type.Session.required = ["session_id:SessionId","device:Device","opened_at:Timestamp","last_active_at:Timestamp","current:boolean"]
identity.kvx:type.SessionList.required = ["sessions:Session[]"]
identity.kvx:type.SessionOpenRequest.required = ["assertion_id:AssertionId"]
identity.kvx:type.SessionRevocation.required = ["revoked_session_ids:SessionId[]","revoked_at:Timestamp"]
identity.kvx:type.StepUpChallenge.binding = "A fresh passkey ceremony that answers for the one operation named by confirms. It cannot be replayed against any other operation."
identity.kvx:type.StepUpChallenge.required = ["challenge_id:StepUpChallengeId","confirms:OperationDigest","ceremony:OpaqueCredential","expires_at:Timestamp"]
identity.kvx:type.StepUpEvidence.reference = "The record other modules carry when an operation requires fresh confirmation: acting on an approval, starting a withdrawal or exit, changing security settings, revealing a secret, replacing the payout wallet, archiving an agent."
identity.kvx:type.StepUpEvidence.required = ["challenge_id:StepUpChallengeId","confirms:OperationDigest","passkey_id:PasskeyId","completed_at:Timestamp","expires_at:Timestamp"]
identity.kvx:type.StepUpFinish.required = ["credential:OpaqueCredential"]
identity.kvx:type.StepUpRequest.required = ["confirms:OperationDigest"]
identity.kvx:type.WalletBinding.checksum = "address always carries the full checksummed mixed-case rendering."
identity.kvx:type.WalletBinding.evidence = "evidence references the receipt-backed record that established the current binding, and the binding reads as bound only once it verifies."
identity.kvx:type.WalletBinding.optional = ["address:EvmAddress","bound_at:Timestamp","evidence:EvidenceRef"]
identity.kvx:type.WalletBinding.required = ["state:BindingState"]
journeys.kvx:module.compatibility = "additive_only"
journeys.kvx:module.contract_major = 1
journeys.kvx:module.name = "journeys"
journeys.kvx:module.spine = "Every operation on this contract speaks in journeys, stages, states and evidence references. Raw protocol structures never cross this boundary."
journeys.kvx:operation.evidence.get.method = "GET"
journeys.kvx:operation.evidence.get.path = "/v1/evidence/{evidence_id}"
journeys.kvx:operation.evidence.get.request = "Empty"
journeys.kvx:operation.evidence.get.response = "EvidenceMaterial"
journeys.kvx:operation.journey.get.method = "GET"
journeys.kvx:operation.journey.get.path = "/v1/journeys/{journey_id}"
journeys.kvx:operation.journey.get.request = "Empty"
journeys.kvx:operation.journey.get.response = "Journey"
journeys.kvx:operation.journey.list.method = "GET"
journeys.kvx:operation.journey.list.path = "/v1/journeys"
journeys.kvx:operation.journey.list.request = "Empty"
journeys.kvx:operation.journey.list.response = "JourneyPage"
journeys.kvx:type.EvidenceClass.variants = ["local-journey-state","submission-record","layerx-receipt","checkpoint-proof","paxeer-finality","typed-refusal","approval-hold","wallet-ack"]
journeys.kvx:type.EvidenceMaterial.material = "The referenced receipt or proof in its canonical bytes, exactly as the protocol produced them, sufficient for export and for verification independent of this plane."
journeys.kvx:type.EvidenceMaterial.required = ["evidence_id:EvidenceId","class:EvidenceClass","verification:VerificationLevel","content_type:string","bytes_base64:string"]
journeys.kvx:type.EvidenceRef.export = "Every evidence reference is sufficient to fetch the receipt or proof material for export and independent verification."
journeys.kvx:type.EvidenceRef.required = ["evidence_id:EvidenceId","class:EvidenceClass","verification:VerificationLevel"]
journeys.kvx:type.Journey.required = ["journey_id:JourneyId","kind:JourneyKind","state:JourneyState","state_copy_key:CopyKey","stages:JourneyStage[]","evidence:EvidenceRef[]","started_at:Timestamp","updated_at:Timestamp"]
journeys.kvx:type.Journey.rule = "A journey is the only shape in which protocol activity reaches a client."
journeys.kvx:type.JourneyKind.boundary = "deposit, withdraw and exit name custody-boundary journeys exclusively. Every movement inside LayerX is move, resolved to fund, allocate, return or transfer by the route resolver."
journeys.kvx:type.JourneyKind.variants = ["onboarding","wallet-binding","deposit","withdraw","exit","move","agent-create","agent-fund","agent-pause","agent-retire"]
journeys.kvx:type.JourneyPage.required = ["journeys:Journey[]","next_cursor:Cursor"]
journeys.kvx:type.JourneyStage.required = ["stage_id:StageId","copy_key:CopyKey","state:JourneyState","evidence:EvidenceRef[]"]
journeys.kvx:type.JourneyState.done-finalised.semantics = "The receipt-backed outcome is additionally covered by a finalised checkpoint proof."
journeys.kvx:type.JourneyState.done.semantics = "Rendered only when a verified LayerX receipt or a verified Paxeer finality proof in the journey's evidence backs the exact outcome."
journeys.kvx:type.JourneyState.refused.semantics = "A typed refusal backs this state and always states whether any money left the account."
journeys.kvx:type.JourneyState.still-checking.semantics = "The outcome is unknown. It resolves only by receipt lookup under the journey's idempotency key, and every duplicate-capable control stays locked while it lasts."
journeys.kvx:type.JourneyState.table = "This vocabulary is the normative status translation table. A state outside it on a default surface is a build failure."
journeys.kvx:type.JourneyState.variants = ["getting-ready","sending","processing","done","done-finalised","still-checking","refused","waiting-for-you"]
journeys.kvx:type.JourneyState.waiting-for-you.semantics = "A policy hold with deterministic expiry awaits the user's approval decision."
journeys.kvx:type.VerificationLevel.ordering = "declaration_order"
journeys.kvx:type.VerificationLevel.variants = ["unverified","receipt-verified","checkpoint-finalised","paxeer-finalised"]
stream.kvx:module.compatibility = "additive_only"
stream.kvx:module.contract_major = 1
stream.kvx:module.name = "stream"
stream.kvx:module.resumption = "Every event carries the stable cursor that names its position. A client that reconnects resumes from the last cursor it processed and receives every later event exactly once, in order, with no gaps and no duplicates. A cursor the service no longer retains is refused with the cursor-expired code, and the client re-opens from the current position."
stream.kvx:module.spine = "Both shells render live state from one resumable event stream: journey progress, approval lifecycle and notifications, delivered in cursor order without polling."
stream.kvx:operation.stream.next.method = "GET"
stream.kvx:operation.stream.next.path = "/v1/stream/{cursor}"
stream.kvx:operation.stream.next.request = "Empty"
stream.kvx:operation.stream.next.response = "StreamPage"
stream.kvx:operation.stream.open.method = "POST"
stream.kvx:operation.stream.open.path = "/v1/stream"
stream.kvx:operation.stream.open.request = "Empty"
stream.kvx:operation.stream.open.response = "StreamPosition"
stream.kvx:type.StreamEvent.optional = ["journey:Journey"]
stream.kvx:type.StreamEvent.payloads = "An event embeds the journey it reports where one exists. Later modules extend the optional payloads additively; the cursor, kind and observed_at spine never changes."
stream.kvx:type.StreamEvent.required = ["cursor:Cursor","kind:StreamEventKind","observed_at:Timestamp"]
stream.kvx:type.StreamEventKind.variants = ["journey-progress","approval-created","approval-approved","approval-rejected","approval-expired","notification"]
stream.kvx:type.StreamPage.paging = "An empty events list with an unchanged next_cursor means the position is current. next_cursor always names the position after the last delivered event and is always safe to resume from."
stream.kvx:type.StreamPage.required = ["events:StreamEvent[]","next_cursor:Cursor"]
stream.kvx:type.StreamPosition.required = ["cursor:Cursor"]
v1.kvx:encoding.amounts = "Every amount is a decimal string of base units, never a JSON number, and always travels with an explicit currency code. TypeScript clients read amounts as bigint."
v1.kvx:encoding.base_path = "/v1"
v1.kvx:encoding.content_type = "application/json"
v1.kvx:encoding.error = "Failure responses carry ok false and a structured error object with a stable machine code, a copy-catalog key, the trace identifier and a retriability classification. No operation returns an unstructured error."
v1.kvx:encoding.idempotency = "Every mutation that could move money or change protocol state requires the Idempotency-Key header, and repeating the request returns the original journey rather than a second effect."
v1.kvx:encoding.idempotency_header = "Idempotency-Key"
v1.kvx:encoding.request = "A JSON object shaped by the operation's request type. Operations declaring the Empty request send no body."
v1.kvx:encoding.response = "A JSON envelope with ok as a boolean, result matching the operation's response type when ok is true, error as a structured object when ok is false, and trace always present."
v1.kvx:encoding.transport = "HTTPS"
v1.kvx:encoding.versioning = "The contract major version is the first segment of every operation path. Within one major version every change is additive."
v1.kvx:golden.failure_layout = "golden/<operation>.failure.json for every operation"
v1.kvx:golden.failure_rule = "Every operation ships a failure vector proving its typed error shape: a non-2xx status and an envelope carrying ok false, the structured ApiError and the trace. An operation without a failure vector fails the conformance suite."
v1.kvx:golden.layout = "golden/<operation>.request.json and golden/<operation>.response.json for every operation"
v1.kvx:golden.request_shape = "method, path, optional headers, optional body"
v1.kvx:golden.response_shape = "status, body"
v1.kvx:golden.rule = "Golden vectors are the executable examples of this contract. The conformance suite fails when an operation lacks vectors or a vector departs from the declared shapes."
v1.kvx:operation.version.method = "GET"
v1.kvx:operation.version.path = "/v1/version"
v1.kvx:operation.version.request = "Empty"
v1.kvx:operation.version.response = "VersionInfo"
v1.kvx:record.Money.fields = ["amount:Amount","currency:CurrencyCode"]
v1.kvx:record.ResponseEnvelope.fields = ["ok:boolean","result:object","trace:TraceId"]
