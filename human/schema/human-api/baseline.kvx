identity.kvx:scalar.PasskeyId.prefix = "pky_"
identity.kvx:scalar.PasskeyId.rust = "String"
identity.kvx:scalar.PasskeyId.typescript = "string"
identity.kvx:scalar.RegistrationId.json = "string"
identity.kvx:scalar.RegistrationId.prefix = "reg_"
identity.kvx:scalar.RegistrationId.rust = "String"
identity.kvx:scalar.RegistrationId.typescript = "string"
identity.kvx:scalar.SessionId.json = "string"
identity.kvx:scalar.SessionId.prefix = "ses_"
identity.kvx:scalar.SessionId.rust = "String"
identity.kvx:scalar.SessionId.typescript = "string"
