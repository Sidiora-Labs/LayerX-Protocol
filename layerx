#!/usr/bin/env bash

# LayerX workspace dashboard. This file intentionally uses only Bash and
# standard host utilities so it can run before project dependencies exist.

set -u

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

MODULE_IDS=(core contracts agent human platform programs interop specgen)
MODULE_NAMES=(
  "Protocol core"
  "Paxeer contracts"
  "Agent layer"
  "Human plane"
  "Developer platform"
  "Programs"
  "Interop gateway"
  "Spec generator"
)
MODULE_DESCRIPTIONS=(
  "C17 ledger, sequencing, storage and proofs"
  "Custody, bridge and governance contracts"
  "Daemon, SDK, wire, proof and policy crates"
  "Custody service, explorer and web app"
  "CLI, hosted tooling, SDKs and middleware"
  "Deterministic runtime and authoring SDKs"
  "x402, mandates, fiat, mirrors and ramps"
  "KVX renderer and workflow tooling"
)
MODULE_TOOLS=(
  "make cc ar docker forge"
  "forge"
  "make cargo"
  "make cargo npm"
  "make cargo npm python3 go java mvn dotnet swift"
  "make cargo npm cc"
  "make cargo"
  "go"
)
SELECTED=(1 1 1 1 1 1 1 1)

ENV_NAMES=(emulator testnet production)
ENV_LABELS=(Emulator Testnet Production)
ENV_ENDPOINTS=("http://127.0.0.1:9402" "" "")
ENV_NETWORKS=(402 "" "")
ENV_INDEX=0

ACTION_LABELS=(Inspect Install Build Test Everything)
ACTION_DESCRIPTIONS=(
  "Check host tools without changing anything"
  "Resolve every selected module's locked dependencies"
  "Build every selected module"
  "Run every selected module's real test gates"
  "Install dependencies, then build and test"
)
ACTION_INDEX=0

DRY_RUN=0
FAIL_FAST=0
CI_MODE=0
FOCUS=0
RUN_REQUESTED=0
QUIT_REQUESTED=0
EVENT=""
CURRENT_CHILD=""
RUN_CANCELLED=0
TERMINAL_ACTIVE=0

STEP_MODULE=()
STEP_PHASE=()
STEP_LABEL=()
STEP_CWD=()
STEP_TOOLS=()
STEP_COMMAND=()
STEP_STATUS=()
STEP_LOG=()

COLOR=0
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  COLOR=1
fi

ESC=$'\033'
RESET="${ESC}[0m"
BOLD="${ESC}[1m"
DIM="${ESC}[2m"
CYAN="${ESC}[36m"
GREEN="${ESC}[32m"
YELLOW="${ESC}[33m"
RED="${ESC}[31m"
BLUE_BG="${ESC}[44;97m"
FOCUS_BG="${ESC}[48;5;238;97m"

paint() {
  local code="$1"
  shift
  if (( COLOR )); then
    printf '%s%s%s' "$code" "$*" "$RESET"
  else
    printf '%s' "$*"
  fi
}

terminal_enter() {
  printf '%s' "${ESC}[?1049h${ESC}[?25l${ESC}[?1000h${ESC}[?1006h"
  TERMINAL_ACTIVE=1
}

terminal_leave() {
  printf '%s' "${ESC}[?1000l${ESC}[?1006l${ESC}[?25h${ESC}[?1049l"
  TERMINAL_ACTIVE=0
}

terminal_mouse_on() {
  printf '%s' "${ESC}[?1000h${ESC}[?1006h"
}

terminal_mouse_off() {
  printf '%s' "${ESC}[?1000l${ESC}[?1006l"
}

cleanup() {
  if [[ -n "$CURRENT_CHILD" ]] && kill -0 "$CURRENT_CHILD" 2>/dev/null; then
    kill "$CURRENT_CHILD" 2>/dev/null || true
    wait "$CURRENT_CHILD" 2>/dev/null || true
  fi
  if (( TERMINAL_ACTIVE )); then
    terminal_leave
  fi
}

trap cleanup EXIT HUP TERM
trap 'RUN_CANCELLED=1; [[ -n "$CURRENT_CHILD" ]] && kill "$CURRENT_CHILD" 2>/dev/null || true' INT

repeat_char() {
  local character="$1"
  local count="$2"
  local output=""
  while (( count > 0 )); do
    output+="$character"
    ((count--))
  done
  printf '%s' "$output"
}

selected_count() {
  local count=0
  local value
  for value in "${SELECTED[@]}"; do
    (( value == 1 )) && ((count++))
  done
  printf '%s' "$count"
}

set_all_modules() {
  local value="$1"
  local index
  for ((index = 0; index < ${#SELECTED[@]}; index++)); do
    SELECTED[index]="$value"
  done
}

missing_tools() {
  local tools="$1"
  local tool
  local missing=""
  for tool in $tools; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      missing+="${missing:+, }$tool"
    fi
  done
  printf '%s' "$missing"
}

module_status() {
  local index="$1"
  local missing
  missing="$(missing_tools "${MODULE_TOOLS[$index]}")"
  if [[ -z "$missing" ]]; then
    paint "$GREEN" "READY"
  else
    paint "$YELLOW" "MISSING $missing"
  fi
}

focus_marker() {
  local index="$1"
  if (( FOCUS == index )); then
    paint "$CYAN" ">"
  else
    printf ' '
  fi
}

chip() {
  local active="$1"
  local focused="$2"
  local label="$3"
  if (( active )); then
    paint "$BLUE_BG" " $label "
  elif (( focused )); then
    paint "$FOCUS_BG" " $label "
  else
    printf '[ %s ]' "$label"
  fi
}

checkbox() {
  local checked="$1"
  local label="$2"
  if (( checked )); then
    paint "$GREEN" "[x] $label"
  else
    printf '[ ] %s' "$label"
  fi
}

clear_screen() {
  printf '%s' "${ESC}[H${ESC}[2J"
}

render_dashboard() {
  local index marker status endpoint network selected module_hint
  clear_screen
  selected="$(selected_count)"
  endpoint="${ENV_ENDPOINTS[$ENV_INDEX]}"
  network="${ENV_NETWORKS[$ENV_INDEX]}"
  module_hint="click rows to toggle"
  if (( FOCUS >= 3 && FOCUS <= 10 )); then
    module_hint="${MODULE_DESCRIPTIONS[$((FOCUS - 3))]}"
  fi

  paint "$BOLD$CYAN" "  LAYERX WORKSPACE"
  printf '   '
  paint "$DIM" "interactive dependency, build and test control"
  printf '\n'
  printf '  %s\n' "$(repeat_char '─' 76)"

  printf '  %s Environment  ' "$(focus_marker 0)"
  for ((index = 0; index < 3; index++)); do
    chip "$((ENV_INDEX == index))" "$((FOCUS == 0))" "${ENV_LABELS[$index]}"
    printf '  '
  done
  printf '\n'

  printf '  %s Endpoint     ' "$(focus_marker 1)"
  if [[ -n "$endpoint" ]]; then
    printf '%-58s' "${endpoint:0:58}"
  else
    paint "$YELLOW" "click or press Enter to configure"
  fi
  printf '\n'

  printf '  %s Network ID   ' "$(focus_marker 2)"
  if [[ -n "$network" ]]; then
    printf '%s' "$network"
  else
    paint "$YELLOW" "click or press Enter to configure"
  fi
  printf '\n\n'

  paint "$BOLD" "  MODULES"
  printf '   '
  paint "$DIM" "$selected/${#MODULE_IDS[@]} selected — $module_hint"
  printf '\n'
  for ((index = 0; index < ${#MODULE_IDS[@]}; index++)); do
    marker="[ ]"
    (( SELECTED[index] == 1 )) && marker="[x]"
    printf '  %s ' "$(focus_marker $((index + 3)))"
    if (( SELECTED[index] == 1 )); then
      paint "$GREEN" "$marker"
    else
      printf '%s' "$marker"
    fi
    printf ' %-24s ' "${MODULE_NAMES[$index]}"
    status="$(module_status "$index")"
    printf '%s\n' "$status"
  done

  printf '\n'
  paint "$BOLD" "  ACTION"
  printf '   '
  paint "$DIM" "${ACTION_DESCRIPTIONS[$ACTION_INDEX]}"
  printf '\n  %s ' "$(focus_marker 11)"
  for ((index = 0; index < ${#ACTION_LABELS[@]}; index++)); do
    chip "$((ACTION_INDEX == index))" "$((FOCUS == 11))" "${ACTION_LABELS[$index]}"
    printf ' '
  done
  printf '\n\n'

  printf '  %s ' "$(focus_marker 12)"
  checkbox "$DRY_RUN" "Plan only"
  printf '    %s ' "$(focus_marker 13)"
  checkbox "$FAIL_FAST" "Stop on failure"
  printf '    %s ' "$(focus_marker 14)"
  checkbox "$CI_MODE" "CI environment"
  printf '\n\n'

  printf '  '
  chip 0 "$((FOCUS == 15))" "Select all"
  printf '  '
  chip 0 "$((FOCUS == 16))" "Clear"
  printf '  '
  chip "$((FOCUS == 17))" "$((FOCUS == 17))" "RUN SELECTED"
  printf '  '
  chip 0 "$((FOCUS == 18))" "Quit"
  printf '\n'

  paint "$DIM" "  Click controls · Arrows/Tab move · Space toggles · Enter activates · q quits"
  printf '\n'
}

read_event() {
  local key next sequence character
  EVENT=""
  IFS= read -rsn1 key || { EVENT="quit"; return; }
  case "$key" in
    "") EVENT="enter" ;;
    " ") EVENT="space" ;;
    $'\t') EVENT="tab" ;;
    q|Q) EVENT="quit" ;;
    a|A) EVENT="all" ;;
    c|C) EVENT="clear" ;;
    r|R) EVENT="run" ;;
    d|D) EVENT="dry" ;;
    $'\033')
      IFS= read -rsn1 -t 1 next || { EVENT="escape"; return; }
      if [[ "$next" != "[" ]]; then
        EVENT="escape"
        return
      fi
      IFS= read -rsn1 -t 1 next || { EVENT="escape"; return; }
      case "$next" in
        A) EVENT="up" ;;
        B) EVENT="down" ;;
        C) EVENT="right" ;;
        D) EVENT="left" ;;
        '<')
          sequence=""
          while IFS= read -rsn1 -t 1 character; do
            sequence+="$character"
            [[ "$character" == "M" || "$character" == "m" ]] && break
          done
          EVENT="mouse:$sequence"
          ;;
        *) EVENT="escape" ;;
      esac
      ;;
    *) EVENT="key:$key" ;;
  esac
}

edit_text_value() {
  local title="$1"
  local current="$2"
  local value
  terminal_mouse_off
  clear_screen
  printf '%s' "${ESC}[?25h"
  paint "$BOLD$CYAN" "  EDIT WORKSPACE ENVIRONMENT"
  printf '\n\n  %s\n\n' "Press Enter to keep the current value."
  printf '  %s [%s]: ' "$title" "$current"
  IFS= read -r value || value=""
  printf '%s' "${ESC}[?25l"
  terminal_mouse_on
  if [[ -n "$value" ]]; then
    EDITED_VALUE="$value"
  else
    EDITED_VALUE="$current"
  fi
}

edit_endpoint() {
  EDITED_VALUE=""
  edit_text_value "Endpoint" "${ENV_ENDPOINTS[$ENV_INDEX]}"
  ENV_ENDPOINTS[ENV_INDEX]="$EDITED_VALUE"
}

edit_network() {
  local before
  before="${ENV_NETWORKS[$ENV_INDEX]}"
  EDITED_VALUE=""
  edit_text_value "Network ID" "$before"
  if [[ "$EDITED_VALUE" =~ ^[0-9]+$ ]]; then
    ENV_NETWORKS[ENV_INDEX]="$EDITED_VALUE"
  else
    ENV_NETWORKS[ENV_INDEX]="$before"
  fi
}

cycle_environment() {
  local direction="$1"
  ENV_INDEX=$(( (ENV_INDEX + direction + 3) % 3 ))
}

cycle_action() {
  local direction="$1"
  ACTION_INDEX=$(( (ACTION_INDEX + direction + ${#ACTION_LABELS[@]}) % ${#ACTION_LABELS[@]} ))
}

activate_focus() {
  case "$FOCUS" in
    0) cycle_environment 1 ;;
    1) edit_endpoint ;;
    2) edit_network ;;
    3|4|5|6|7|8|9|10)
      local module_index=$((FOCUS - 3))
      SELECTED[module_index]=$((1 - SELECTED[module_index]))
      ;;
    11) cycle_action 1 ;;
    12) DRY_RUN=$((1 - DRY_RUN)) ;;
    13) FAIL_FAST=$((1 - FAIL_FAST)) ;;
    14) CI_MODE=$((1 - CI_MODE)) ;;
    15) set_all_modules 1 ;;
    16) set_all_modules 0 ;;
    17) RUN_REQUESTED=1 ;;
    18) QUIT_REQUESTED=1 ;;
  esac
}

handle_click() {
  local x="$1"
  local y="$2"
  local index
  case "$y" in
    3)
      FOCUS=0
      if (( x >= 18 && x <= 27 )); then ENV_INDEX=0
      elif (( x >= 30 && x <= 40 )); then ENV_INDEX=1
      elif (( x >= 43 && x <= 56 )); then ENV_INDEX=2
      fi
      ;;
    4) FOCUS=1; edit_endpoint ;;
    5) FOCUS=2; edit_network ;;
    8|9|10|11|12|13|14|15)
      index=$((y - 8))
      FOCUS=$((index + 3))
      SELECTED[index]=$((1 - SELECTED[index]))
      ;;
    18)
      FOCUS=11
      if (( x >= 5 && x <= 13 )); then ACTION_INDEX=0
      elif (( x >= 15 && x <= 25 )); then ACTION_INDEX=1
      elif (( x >= 27 && x <= 35 )); then ACTION_INDEX=2
      elif (( x >= 37 && x <= 44 )); then ACTION_INDEX=3
      elif (( x >= 46 && x <= 59 )); then ACTION_INDEX=4
      fi
      ;;
    20)
      if (( x >= 5 && x <= 17 )); then FOCUS=12; DRY_RUN=$((1 - DRY_RUN))
      elif (( x >= 24 && x <= 42 )); then FOCUS=13; FAIL_FAST=$((1 - FAIL_FAST))
      elif (( x >= 49 && x <= 66 )); then FOCUS=14; CI_MODE=$((1 - CI_MODE))
      fi
      ;;
    22)
      if (( x >= 3 && x <= 16 )); then FOCUS=15; set_all_modules 1
      elif (( x >= 19 && x <= 27 )); then FOCUS=16; set_all_modules 0
      elif (( x >= 30 && x <= 43 )); then FOCUS=17; RUN_REQUESTED=1
      elif (( x >= 46 && x <= 53 )); then FOCUS=18; QUIT_REQUESTED=1
      fi
      ;;
  esac
}

handle_mouse_event() {
  local payload="$1"
  local suffix button x y
  suffix="${payload: -1}"
  [[ "$suffix" == "M" ]] || return
  payload="${payload%?}"
  IFS=';' read -r button x y <<< "$payload"
  [[ "$button" =~ ^[0-9]+$ && "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]] || return
  (( button == 0 )) || return
  handle_click "$x" "$y"
}

handle_dashboard_event() {
  case "$EVENT" in
    up) FOCUS=$(( (FOCUS + 18) % 19 )) ;;
    down|tab) FOCUS=$(( (FOCUS + 1) % 19 )) ;;
    left)
      if (( FOCUS == 0 )); then cycle_environment -1
      elif (( FOCUS == 11 )); then cycle_action -1
      else FOCUS=$(( (FOCUS + 18) % 19 ))
      fi
      ;;
    right)
      if (( FOCUS == 0 )); then cycle_environment 1
      elif (( FOCUS == 11 )); then cycle_action 1
      else FOCUS=$(( (FOCUS + 1) % 19 ))
      fi
      ;;
    enter|space) activate_focus ;;
    all) set_all_modules 1 ;;
    clear) set_all_modules 0 ;;
    run) RUN_REQUESTED=1 ;;
    dry) DRY_RUN=$((1 - DRY_RUN)) ;;
    quit|escape) QUIT_REQUESTED=1 ;;
    mouse:*) handle_mouse_event "${EVENT#mouse:}" ;;
  esac
}

add_step() {
  STEP_MODULE+=("$1")
  STEP_PHASE+=("$2")
  STEP_LABEL+=("$3")
  STEP_CWD+=("$4")
  STEP_TOOLS+=("$5")
  STEP_COMMAND+=("$6")
  STEP_STATUS+=("WAITING")
  STEP_LOG+=("")
}

