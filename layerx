append_module_steps() {
  local module="$1"
  local phase="$2"
  case "$module" in
    core) append_core_steps "$phase" ;;
    contracts) append_contracts_steps "$phase" ;;
    agent) append_agent_steps "$phase" ;;
    human) append_human_steps "$phase" ;;
    platform) append_platform_steps "$phase" ;;
    programs) append_programs_steps "$phase" ;;
    interop) append_interop_steps "$phase" ;;
    specgen) append_specgen_steps "$phase" ;;
  esac
}

reset_plan() {
  STEP_MODULE=()
  STEP_PHASE=()
  STEP_LABEL=()
  STEP_CWD=()
  STEP_TOOLS=()
  STEP_COMMAND=()
  STEP_STATUS=()
  STEP_LOG=()
}

build_plan() {
  local phases=()
  local phase module_index
  reset_plan
  case "$ACTION_INDEX" in
    1) phases=(INSTALL) ;;
    2) phases=(BUILD) ;;
    3) phases=(TEST) ;;
    4) phases=(INSTALL BUILD TEST) ;;
    *) return ;;
  esac
  for phase in "${phases[@]}"; do
    for ((module_index = 0; module_index < ${#MODULE_IDS[@]}; module_index++)); do
      if (( SELECTED[module_index] == 1 )); then
        append_module_steps "${MODULE_IDS[$module_index]}" "$phase"
      fi
    done
  done
}

selected_module_names() {
  local result=""
  local index
  for ((index = 0; index < ${#MODULE_IDS[@]}; index++)); do
    if (( SELECTED[index] == 1 )); then
      result+="${result:+, }${MODULE_NAMES[$index]}"
    fi
  done
  printf '%s' "$result"
}

production_authorized() {
  local answer=""
  if (( ENV_INDEX != 2 || (ACTION_INDEX != 3 && ACTION_INDEX != 4) )); then
    return 0
  fi
  clear_screen
  paint "$BOLD$RED" "  PRODUCTION TEST SAFETY"
  printf '\n\n  Test settings will be exported as production to every selected test process.\n'
  printf '  Type production to unlock this run. No process starts until you do.\n\n'
  terminal_mouse_off
  printf '%s' "${ESC}[?25h"
  printf '  Confirmation: '
  IFS= read -r answer || answer=""
  printf '%s' "${ESC}[?25l"
  terminal_mouse_on
  [[ "$answer" == "production" ]]
}

render_confirmation() {
  local choice="$1"
  local total online dry endpoint network
  total="${#STEP_MODULE[@]}"
  endpoint="${ENV_ENDPOINTS[$ENV_INDEX]:-(not configured)}"
  network="${ENV_NETWORKS[$ENV_INDEX]:-(not configured)}"
  online="No"
  (( ACTION_INDEX == 1 || ACTION_INDEX == 4 )) && online="Yes — locked dependencies may be downloaded"
  dry="No"
  (( DRY_RUN == 1 )) && dry="Yes — nothing will execute"
  clear_screen
  paint "$BOLD$CYAN" "  REVIEW WORKSPACE RUN"
  printf '\n  %s\n\n' "$(repeat_char '─' 72)"
  printf '  Action        %s\n' "${ACTION_LABELS[$ACTION_INDEX]}"
  printf '  Modules       %s selected\n' "$(selected_count)"
  printf '  Environment   %s\n' "${ENV_LABELS[$ENV_INDEX]}"
  printf '  Endpoint      %s\n' "$endpoint"
  printf '  Network ID    %s\n' "$network"
  printf '  Steps         %s\n' "$total"
  printf '  Network use   %s\n' "$online"
  printf '  Plan only     %s\n\n' "$dry"
  if (( ACTION_INDEX == 1 || ACTION_INDEX == 4 )); then
    paint "$YELLOW" "  Install steps can access package registries. Nothing runs without confirmation."
    printf '\n\n'
  fi
  printf '  '
  chip "$((choice == 0))" "$((choice == 0))" "Cancel"
  printf '     '
  chip "$((choice == 1))" "$((choice == 1))" "RUN NOW"
  printf '\n\n'
  paint "$DIM" "  Click a button · left/right chooses · Enter confirms · Esc cancels"
  printf '\n'
}

confirm_run() {
  local choice=0 payload suffix button x y button_row
  button_row=13
  (( ACTION_INDEX == 1 || ACTION_INDEX == 4 )) && button_row=15
  while true; do
    render_confirmation "$choice"
    read_event
    case "$EVENT" in
      left|right|tab) choice=$((1 - choice)) ;;
      enter|space) (( choice == 1 )) && return 0 || return 1 ;;
      quit|escape) return 1 ;;
      mouse:*)
        payload="${EVENT#mouse:}"
        suffix="${payload: -1}"
        [[ "$suffix" == "M" ]] || continue
        payload="${payload%?}"
        IFS=';' read -r button x y <<< "$payload"
        [[ "$button" == "0" && "$y" == "$button_row" ]] || continue
        if (( x >= 3 && x <= 12 )); then return 1
        elif (( x >= 18 && x <= 26 )); then return 0
        fi
        ;;
    esac
  done
}

render_doctor() {
  local index missing
  clear_screen
  paint "$BOLD$CYAN" "  WORKSPACE READINESS"
  printf '   '
  paint "$DIM" "read-only host inspection"
  printf '\n  %s\n\n' "$(repeat_char '─' 82)"
  printf '  Environment   %s\n' "${ENV_LABELS[$ENV_INDEX]}"
  printf '  Endpoint      %s\n' "${ENV_ENDPOINTS[$ENV_INDEX]:-(not configured)}"
  printf '  Network ID    %s\n\n' "${ENV_NETWORKS[$ENV_INDEX]:-(not configured)}"
  for ((index = 0; index < ${#MODULE_IDS[@]}; index++)); do
    (( SELECTED[index] == 1 )) || continue
    missing="$(missing_tools "${MODULE_TOOLS[$index]}")"
    printf '  %-22s ' "${MODULE_NAMES[$index]}"
    if [[ -z "$missing" ]]; then
      paint "$GREEN" "READY"
    else
      paint "$YELLOW" "BLOCKED"
      printf '  missing %s' "$missing"
    fi
    printf '\n'
  done
  printf '\n  '
  chip 1 0 "BACK TO DASHBOARD"
  printf '\n\n'
  paint "$DIM" "  Click Back or press any key"
  printf '\n'
}

show_doctor() {
  render_doctor
  read_event
}

show_notice() {
  local title="$1"
  local message="$2"
  clear_screen
  paint "$BOLD$YELLOW" "  $title"
  printf '\n\n  %s\n\n  ' "$message"
  chip 1 0 "BACK TO DASHBOARD"
  printf '\n\n'
  paint "$DIM" "  Click Back or press any key"
  printf '\n'
  read_event
}

status_color() {
  case "$1" in
    PASSED) printf '%s' "$GREEN" ;;
    RUNNING) printf '%s' "$CYAN" ;;
    PLANNED|SKIPPED) printf '%s' "$DIM" ;;
    BLOCKED|FAILED|CANCELLED) printf '%s' "$RED" ;;
    *) printf '%s' "$YELLOW" ;;
  esac
}

render_log_tail() {
  local log_file="$1"
  if [[ -z "$log_file" || ! -f "$log_file" ]]; then
    paint "$DIM" "  Waiting for output…"
    printf '\n'
    return
  fi
  tail -n 6 "$log_file" 2>/dev/null | sed -E $'s/\033\[[0-9;?]*[ -\/]*[@-~]//g; s/[^[:print:]\t]//g' | while IFS= read -r line; do
    printf '  %.76s\n' "$line"
  done
}

progress_bar() {
  local complete="$1"
  local total="$2"
  local width=52
  local filled=0
  (( total > 0 )) && filled=$((complete * width / total))
  printf '['
  paint "$CYAN" "$(repeat_char '█' "$filled")"
  repeat_char '░' "$((width - filled))"
  printf '] %d/%d' "$complete" "$total"
}

render_execution() {
  local current="$1"
  local run_log="$2"
  local total="${#STEP_MODULE[@]}"
  local start end index code
  clear_screen
  paint "$BOLD$CYAN" "  LAYERX WORKSPACE RUN"
  printf '   %s · %s\n' "${ACTION_LABELS[$ACTION_INDEX]}" "${ENV_LABELS[$ENV_INDEX]}"
  printf '  '
  progress_bar "$current" "$total"
  printf '\n\n'
  start=$((current - 3))
  (( start < 0 )) && start=0
  end=$((start + 7))
  (( end > total )) && end=$total
  for ((index = start; index < end; index++)); do
    code="$(status_color "${STEP_STATUS[$index]}")"
    if (( index == current && current < total )); then
      printf '  '
      paint "$CYAN" ">"
    else
      printf '   '
    fi
    printf ' %-10s %-8s ' "${STEP_MODULE[$index]}" "${STEP_PHASE[$index]}"
    paint "$code" "${STEP_STATUS[$index]}"
    printf '  %.43s\n' "${STEP_LABEL[$index]}"
  done
  printf '\n'
  paint "$BOLD" "  LIVE OUTPUT"
  printf '\n  %s\n' "$(repeat_char '─' 76)"
  render_log_tail "$run_log"
  printf '\n'
  paint "$DIM" "  Ctrl-C cancels the active process; completed module results are preserved."
  printf '\n'
}

run_one_step() {
  local index="$1"
  local run_directory="$2"
  local missing command log_file exit_code
  missing="$(missing_tools "${STEP_TOOLS[$index]}")"
  if (( DRY_RUN )); then
    log_file=""
    STEP_LOG[index]=""
    STEP_STATUS[index]="PLANNED"
    render_execution "$((index + 1))" "$log_file"
    return 0
  fi
  log_file="$run_directory/$(printf '%03d' "$((index + 1))")-${STEP_MODULE[$index]}-${STEP_PHASE[$index]}.log"
  STEP_LOG[index]="$log_file"
  if [[ "${STEP_COMMAND[$index]}" == ":" ]]; then
    STEP_STATUS[index]="SKIPPED"
    render_execution "$((index + 1))" "$log_file"
    return 0
  fi
  if [[ -n "$missing" ]]; then
    STEP_STATUS[index]="BLOCKED"
    printf 'Missing host tools: %s\n' "$missing" > "$log_file"
    render_execution "$((index + 1))" "$log_file"
    return 1
  fi

  STEP_STATUS[index]="RUNNING"
  command="${STEP_COMMAND[$index]}"
  (
    cd "$ROOT_DIR/${STEP_CWD[$index]}" || exit 127
    export LAYERX_ENVIRONMENT="${ENV_NAMES[$ENV_INDEX]}"
    export LAYERX_ENDPOINT="${ENV_ENDPOINTS[$ENV_INDEX]}"
    export LAYERX_NETWORK_ID="${ENV_NETWORKS[$ENV_INDEX]}"
    if (( CI_MODE )); then export CI=1; fi
    bash -c "exec $command"
  ) </dev/null >"$log_file" 2>&1 &
  CURRENT_CHILD=$!
  while kill -0 "$CURRENT_CHILD" 2>/dev/null; do
    render_execution "$index" "$log_file"
    if IFS= read -rsn1 -t 0.15 command; then
      if [[ "$command" == $'\003' ]]; then
        RUN_CANCELLED=1
        kill "$CURRENT_CHILD" 2>/dev/null || true
      fi
    fi
  done
  wait "$CURRENT_CHILD"
  exit_code=$?
  CURRENT_CHILD=""
  if (( RUN_CANCELLED )); then
    STEP_STATUS[index]="CANCELLED"
    return 130
  elif (( exit_code == 0 )); then
    STEP_STATUS[index]="PASSED"
    return 0
  else
    STEP_STATUS[index]="FAILED"
    return "$exit_code"
  fi
}

render_results() {
  local passed=0 failed=0 blocked=0 planned=0 skipped=0 cancelled=0 waiting=0
  local index status code start total
  total="${#STEP_STATUS[@]}"
  for status in "${STEP_STATUS[@]}"; do
    case "$status" in
      PASSED) ((passed++)) ;;
      FAILED) ((failed++)) ;;
      BLOCKED) ((blocked++)) ;;
      PLANNED) ((planned++)) ;;
      SKIPPED) ((skipped++)) ;;
      CANCELLED) ((cancelled++)) ;;
      WAITING) ((waiting++)) ;;
    esac
  done
  clear_screen
  paint "$BOLD$CYAN" "  WORKSPACE RESULTS"
  printf '\n  %s\n\n' "$(repeat_char '─' 76)"
  printf '  '
  paint "$GREEN" "$passed passed"
  printf '   '
  paint "$RED" "$failed failed"
  printf '   '
  paint "$YELLOW" "$blocked blocked"
  printf '\n  %s planned   %s skipped   %s cancelled   %s not run\n\n' "$planned" "$skipped" "$cancelled" "$waiting"
  start=$((total - 14))
  (( start < 0 )) && start=0
  for ((index = start; index < total; index++)); do
    status="${STEP_STATUS[$index]}"
    code="$(status_color "$status")"
    printf '  %-10s %-8s ' "${STEP_MODULE[$index]}" "${STEP_PHASE[$index]}"
    paint "$code" "$status"
    printf '  %.44s\n' "${STEP_LABEL[$index]}"
  done
  if [[ -n "$RUN_DIRECTORY" ]]; then
    printf '\n  Logs: %s\n\n  ' "$RUN_DIRECTORY"
  else
    printf '\n  Plan only: no commands ran and no log files were created.\n\n  '
  fi
  chip 1 0 "BACK TO DASHBOARD"
  printf '\n'
}

run_plan() {
  local timestamp index result=0 completed=0 last_log=""
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  RUN_DIRECTORY=""
  if (( ! DRY_RUN )); then
    RUN_DIRECTORY="$ROOT_DIR/.logs/workspace/$timestamp"
    mkdir -p "$RUN_DIRECTORY"
  fi
  RUN_CANCELLED=0
  for ((index = 0; index < ${#STEP_MODULE[@]}; index++)); do
    if ! run_one_step "$index" "$RUN_DIRECTORY"; then
      result=1
      completed=$((index + 1))
      if (( RUN_CANCELLED || FAIL_FAST )); then
        break
      fi
    else
      completed=$((index + 1))
    fi
  done
  if (( completed > 0 )); then
    last_log="${STEP_LOG[$((completed - 1))]}"
  fi
  render_execution "$completed" "$last_log"
  render_results
  read_event
  return "$result"
}

start_current_action() {
  RUN_REQUESTED=0
  if (( $(selected_count) == 0 )); then
    show_notice "NO MODULES SELECTED" "Select at least one module before starting a workspace action."
    return
  fi
  if (( ACTION_INDEX == 0 )); then
    show_doctor
    return
  fi
  if [[ -z "${ENV_ENDPOINTS[$ENV_INDEX]}" || -z "${ENV_NETWORKS[$ENV_INDEX]}" ]]; then
    FOCUS=1
    edit_endpoint
    FOCUS=2
    edit_network
    if [[ -z "${ENV_ENDPOINTS[$ENV_INDEX]}" || -z "${ENV_NETWORKS[$ENV_INDEX]}" ]]; then
      show_notice "ENVIRONMENT NOT CONFIGURED" "Enter both an endpoint and a numeric network ID before running this action."
      return
    fi
  fi
  build_plan
  production_authorized || return
  confirm_run || return
  run_plan || true
}

wait_for_usable_terminal() {
  local size rows columns
  while true; do
    size="$(stty size 2>/dev/null || true)"
    read -r rows columns <<< "$size"
    [[ "$rows" =~ ^[0-9]+$ && "$columns" =~ ^[0-9]+$ ]] || { rows=24; columns=80; }
    (( rows == 0 )) && rows=24
    (( columns == 0 )) && columns=80
    if (( rows >= 24 && columns >= 78 )); then
      return 0
    fi
    clear_screen
    paint "$BOLD$YELLOW" "  TERMINAL TOO SMALL"
    printf '\n\n  LayerX Workspace needs at least 78 columns and 24 rows.\n'
    printf '  Current terminal: %s columns by %s rows.\n\n' "$columns" "$rows"
    paint "$DIM" "  Resize the terminal and press any key, or press q to quit."
    printf '\n'
    read_event
    [[ "$EVENT" == "quit" || "$EVENT" == "escape" ]] && return 1
  done
}

dashboard_main() {
  if (( $# != 0 )); then
    printf 'LayerX Workspace is an interactive dashboard. Launch it without subcommands.\n' >&2
    return 2
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'LayerX Workspace needs an interactive terminal.\n' >&2
    return 2
  fi
  if [[ ! -f "$ROOT_DIR/Makefile" || ! -f "$ROOT_DIR/platform/Cargo.toml" ]]; then
    printf 'The dashboard must remain in the LayerX repository root.\n' >&2
    return 2
  fi
  terminal_enter
  while (( ! QUIT_REQUESTED )); do
    wait_for_usable_terminal || break
    render_dashboard
    read_event
    handle_dashboard_event
    if (( RUN_REQUESTED )); then
      start_current_action
    fi
  done
}

if [[ "${LAYERX_DASHBOARD_LIBRARY:-0}" != "1" ]]; then
  dashboard_main "$@"
fi
