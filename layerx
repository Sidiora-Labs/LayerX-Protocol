append_interop_steps() {
  case "$1" in
    INSTALL) add_step interop INSTALL "Fetch locked interop workspace crates" "." "cargo" "cargo fetch --manifest-path interop/Cargo.toml --locked" ;;
    BUILD) add_step interop BUILD "Build every interop adapter" "." "make cargo" "make interop-build" ;;
    TEST) add_step interop TEST "Test every interop adapter" "." "make cargo" "make interop-test" ;;
  esac
}

append_specgen_steps() {
  case "$1" in
    INSTALL) add_step specgen INSTALL "Download specification generator modules" "spec/specgen" "go" "go mod download" ;;
    BUILD) add_step specgen BUILD "Build the specification generator" "spec/specgen" "go" "go build ./..." ;;
    TEST) add_step specgen TEST "Test the specification generator" "spec/specgen" "go" "go test ./..." ;;
