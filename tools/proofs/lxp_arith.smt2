(set-logic ALL)

(echo "schoolbook-limb-accumulator-cannot-overflow")
(push)
(declare-const limb-a (_ BitVec 32))
(declare-const limb-b (_ BitVec 32))
(declare-const limb-existing (_ BitVec 32))
(declare-const limb-carry (_ BitVec 32))
(define-fun limb-sum () (_ BitVec 65)
  (bvadd
    (bvmul ((_ zero_extend 33) limb-a) ((_ zero_extend 33) limb-b))
    ((_ zero_extend 33) limb-existing)
    ((_ zero_extend 33) limb-carry)))
(assert (= ((_ extract 64 64) limb-sum) #b1))
(check-sat)
(pop)

(echo "u128-schoolbook-product-equals-u256-product")
(push)
(declare-const a0 Int)
(declare-const a1 Int)
(declare-const a2 Int)
(declare-const a3 Int)
(declare-const b0 Int)
(declare-const b1 Int)
(declare-const b2 Int)
(declare-const b3 Int)
(define-fun limb-base () Int 4294967296)
(define-fun limb-base-2 () Int (* limb-base limb-base))
(define-fun limb-base-3 () Int (* limb-base-2 limb-base))
(define-fun limb-base-4 () Int (* limb-base-3 limb-base))
(define-fun limb-base-5 () Int (* limb-base-4 limb-base))
(define-fun limb-base-6 () Int (* limb-base-5 limb-base))
(assert (and (>= a0 0) (< a0 limb-base) (>= a1 0) (< a1 limb-base)
             (>= a2 0) (< a2 limb-base) (>= a3 0) (< a3 limb-base)
             (>= b0 0) (< b0 limb-base) (>= b1 0) (< b1 limb-base)
             (>= b2 0) (< b2 limb-base) (>= b3 0) (< b3 limb-base)))
(define-fun multiplicand-a () Int
  (+ a0 (* a1 limb-base) (* a2 limb-base-2) (* a3 limb-base-3)))
(define-fun multiplicand-b () Int
  (+ b0 (* b1 limb-base) (* b2 limb-base-2) (* b3 limb-base-3)))
(define-fun schoolbook () Int
  (+ (* a0 b0)
     (* (+ (* a0 b1) (* a1 b0)) limb-base)
     (* (+ (* a0 b2) (* a1 b1) (* a2 b0)) limb-base-2)
     (* (+ (* a0 b3) (* a1 b2) (* a2 b1) (* a3 b0)) limb-base-3)
     (* (+ (* a1 b3) (* a2 b2) (* a3 b1)) limb-base-4)
     (* (+ (* a2 b3) (* a3 b2)) limb-base-5)
     (* a3 b3 limb-base-6)))
(define-fun direct-product () Int (* multiplicand-a multiplicand-b))
(assert (not (= schoolbook direct-product)))
(check-sat)
(pop)

(echo "restoring-division-step-preserves-euclidean-invariant")
(push)
(declare-const division-r Int)
(declare-const division-d Int)
(declare-const division-bit Int)
(assert (> division-d 0))
(assert (< division-d 340282366920938463463374607431768211456))
(assert (>= division-r 0))
(assert (< division-r division-d))
(assert (or (= division-bit 0) (= division-bit 1)))
(define-fun division-t () Int (+ (* 2 division-r) division-bit))
(define-fun division-qbit () Int (ite (>= division-t division-d) 1 0))
(define-fun division-next-r () Int
  (- division-t (* division-qbit division-d)))
(assert (not (and
  (>= division-next-r 0)
  (< division-next-r division-d)
  (= division-t
     (+ (* division-qbit division-d) division-next-r)))))
(check-sat)
(pop)

(echo "u256-division-overflow-predicate-is-exact")
(push)
(declare-const division-top Int)
(declare-const division-low Int)
(declare-const overflow-divisor Int)
(assert (>= division-top 0))
(assert (< division-top 340282366920938463463374607431768211456))
(assert (>= division-low 0))
(assert (< division-low 340282366920938463463374607431768211456))
(assert (> overflow-divisor 0))
(assert (< overflow-divisor 340282366920938463463374607431768211456))
(define-fun full-dividend () Int
  (+ (* division-top 340282366920938463463374607431768211456)
     division-low))
(assert (not (= (>= division-top overflow-divisor)
                (>= full-dividend
                    (* overflow-divisor
                       340282366920938463463374607431768211456)))))
(check-sat)
(pop)

(echo "floor-and-ceiling-rounding-directions-are-exact")
(push)
(declare-const rounding-product Int)
(assert (>= rounding-product 0))
(define-fun rounding-divisor () Int 10000)
(define-fun rounding-q () Int (div rounding-product rounding-divisor))
(define-fun rounding-r () Int (mod rounding-product rounding-divisor))
(define-fun rounding-ceil () Int
  (+ rounding-q (ite (= rounding-r 0) 0 1)))
(assert (not (and
  (>= rounding-r 0)
  (< rounding-r rounding-divisor)
  (= rounding-product
     (+ (* rounding-q rounding-divisor) rounding-r))
  (<= (* rounding-q rounding-divisor) rounding-product)
  (< rounding-product (* (+ rounding-q 1) rounding-divisor))
  (<= rounding-product (* rounding-ceil rounding-divisor))
  (or (= rounding-product 0)
      (< (* (- rounding-ceil 1) rounding-divisor) rounding-product)))))
(check-sat)
(pop)

(exit)
